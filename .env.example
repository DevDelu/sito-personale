NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protegge le route /api/cron/* (Vercel Cron invia questo secret come
# Authorization: Bearer <CRON_SECRET>); se non impostata, quelle route
# restano invocabili senza autenticazione.
CRON_SECRET=

# Agenda: notifica via email (cron notturno /api/agenda/cron-sync) quando il
# refresh token Google scade e serve riconnettersi manualmente. Stesso
# provider usato dal form contatti del sito pubblico.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AGENDA_ALERT_EMAIL=
# Destinatario dei messaggi del form contatti pubblico; se assente si usa
# AGENDA_ALERT_EMAIL.
CONTACT_TO_EMAIL=
# Base URL assoluta usata nel link dell'email; se assente si usa VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile: verifica anti-bot su form contatti e login.
# Site Key è pubblica (client), Secret Key resta solo server-side.
# Crea il widget su dash.cloudflare.com → Turnstile (gratuito, modalità Managed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Destinatario dell'alert quando il rate limit del login scatta (tentativi
# sospetti). Se assente si usa AGENDA_ALERT_EMAIL, come per CONTACT_TO_EMAIL.
LOGIN_ALERT_EMAIL=
